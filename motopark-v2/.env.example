# MotoPark V2 frontend — copy to .env.local for development
# Existing V1 backend (untouched) — served from ../backend on :5000
# NOTE: this value MUST include the /api suffix — services call api.get('/categories'),
# and the backend mounts every route under /api. A bare host 404s on every request.
VITE_API_BASE_URL=http://localhost:5000/api

# Google Analytics 4 — set the Measurement ID (G-XXXXXXXXXX) in prod to enable
# analytics. Left blank/unset, all tracking is a no-op (no script, no network).
VITE_GA_MEASUREMENT_ID=

# Sitemap generator (scripts/generate-sitemap.mjs, runs at build time). Optional:
#   SITE_ORIGIN       public site origin  (default https://motoparkvizag.in)
#   SITEMAP_API_BASE  API base incl. /api (defaults from VITE_API_BASE_URL)
