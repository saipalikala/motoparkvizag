{
  "name": "motopark-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/generate-sitemap.mjs && vite build && node scripts/check-budgets.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "analyze": "cross-env ANALYZE=1 vite build && node scripts/check-budgets.mjs",
    "lhci": "lhci autorun",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "lh:cinematic": "node scripts/lh-desktop-cinematic.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "images": "node scripts/generate-hero-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "axios": "^1.18.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "vite": "^8.1.1"
  }
}
