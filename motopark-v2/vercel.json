{
  "redirects": [
    {
      "source": "/category/:slug",
      "destination": "/c/:slug",
      "permanent": true
    },
    {
      "source": "/product/:id",
      "destination": "/products/:id",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/orders",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/orders/:id",
      "destination": "/account",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },

    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
