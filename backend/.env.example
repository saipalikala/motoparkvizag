# ── Database ──────────────────────────────────────────────
# Local development MUST NOT point at the production database. config/db.js
# refuses to boot when NODE_ENV and the database target disagree in either
# direction, and rejects a URI with no explicit database name (mongoose would
# silently default to "test" on whatever cluster it was handed).
#
# The database name is REQUIRED — never omit it:
#   local:   mongodb://127.0.0.1:27017/motopark_dev
#   sandbox: mongodb+srv://<user>:<pw>@<cluster>/motopark_dev?appName=Cluster0
#
# ⚠️  Using the production CLUSTER with a `motopark_dev` database isolates the
# data but NOT the credentials or the cluster itself — production is one mistyped
# database name away. A separate cluster is the only true isolation.
#
# Populate the sandbox with baseline data:  npm run db:seed
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/motopark_dev

# Guard tuning (defaults are correct for this project — override only if the
# production cluster is rotated):
#   PROD_DB_HOST=cluster0.2hgw1zn.mongodb.net
#   PROD_DB_NAME=motopark
#
# ALLOW_DB_ENV_MISMATCH=1  bypass the guard — required for a staging deploy,
#                          which runs NODE_ENV=production against a staging DB.
# SYNC_INDEXES=1           run syncIndexes() in production for ONE boot. It DROPS
#                          any index missing from the local schema, so it never
#                          runs automatically in production. Dev syncs by default.

# ── Sessions / JWT ────────────────────────────────────────
# Signs BOTH admin and customer tokens. Required — there is no safe default.
#
# ⚠️  SECURITY: the customer paths (userController.js, orderRoutes.js,
# paymentRoutes.js) fall back to the string "motopark_user_secret" when this is
# unset. That fallback is committed to this repository, so an unset JWT_SECRET
# means anyone who can read the repo can forge a customer session. The admin
# path has no fallback and simply fails instead. Always set this.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Admin login ───────────────────────────────────────────
# The admin account is NOT in the database — controllers/adminController.js
# compares directly against these two values, so `npm run db:seed` cannot
# create one. Without them there is no way to log into the admin panel.
#
# ADMIN_PASSWORD_HASH is a bcrypt hash (cost 10), NOT the password itself.
# Generate one (quote the password so the shell leaves it alone):
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
#
# The hash contains $ characters. Some hosts (and docker-compose) treat $ as
# interpolation — single-quote or escape it there, or the login silently fails.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ── Media uploads (Cloudinary) ────────────────────────────
# Without these, every image and video upload in the admin panel fails.
# config/cloudinary.js derives CLOUDINARY_URL from these three at boot (the
# video path needs the URL form), so setting the three below is enough.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Transactional email (Resend) ──────────────────────────
# Used for OTP login codes (userController.js sendOtp).
RESEND_API_KEY=

# REQUIRED for OTP to reach real users, not just the Resend account owner.
# Without FROM_EMAIL (or outside NODE_ENV=production), the sender falls back to
# Resend's shared sandbox address "onboarding@resend.dev", which Resend hard-
# restricts to delivering ONLY to the email address the Resend account itself
# was signed up with — every other recipient gets a silent-to-the-user 422
# ("Invalid `to` field...") and never receives their code.
#
# To fix for real: verify a sending domain in the Resend dashboard (Domains →
# Add Domain → add the SPF/DKIM DNS records it gives you), THEN set this to an
# address on that verified domain, e.g.:
#   FROM_EMAIL=otp@motoparkvizag.in
# Setting FROM_EMAIL alone with an unverified domain does NOT fix delivery —
# Resend rejects the send the same way regardless of which "from" address you
# pick until the domain itself is verified on the account.
FROM_EMAIL=

# ── Google sign-in ────────────────────────────────────────
# Verifies the Google ID token audience. MUST be the same client id the
# frontend renders with — motopark-v2/.env VITE_GOOGLE_CLIENT_ID. If they
# disagree, sign-in fails audience validation with a confusing error.
# Optional: unset disables the Google button rather than breaking auth
# (userController.js:225 guards it; the frontend hides the button).
GOOGLE_CLIENT_ID=

# ── Payments ──────────────────────────────────────────────
# RAZORPAY_KEY_ID must match the frontend's VITE_RAZORPAY_KEY_ID exactly.
# Use rzp_test_* keys in development — rzp_live_* charges real cards.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret — a SEPARATE value from RAZORPAY_KEY_SECRET. You set it
# yourself when creating the webhook in the Razorpay dashboard (Settings →
# Webhooks), pointing at https://<your-api-host>/api/webhooks/razorpay and
# subscribing to the payment.captured event. Verifies POST /api/webhooks/razorpay.
# If unset, the webhook rejects every delivery (fails closed) rather than crashing.
RAZORPAY_WEBHOOK_SECRET=

# ── AI Assistant (MotoBuddy) ──────────────────────────────
# Default provider is Google Gemini (free tier — no card needed).
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Switch to OpenAI later with ZERO code change — just set these two:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional overrides (sensible per-provider defaults live in ai/config.js)
AI_PROVIDER=gemini
# AI_CHAT_MODEL=gemini-2.5-flash     # verified working; change if your key serves a different model
# AI_EMBED_MODEL=gemini-embedding-001
# AI_EMBED_DIMS=3072                 # MUST match the model + Atlas vector index
AI_VECTOR_INDEX=product_vector_index
AI_MAX_ITERATIONS=5
AI_RETURN_WINDOW_DAYS=7
